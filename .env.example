# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
#
# .env is git-ignored so your key never leaves your machine.

# --- Premium mode (Gemini TTS) ---------------------------------------------
# Required for premium mode. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# --- Optional voice/style overrides ----------------------------------------
# Any Gemini prebuilt voice name (default: Enceladus).
# SPEAKY_VOICE=Enceladus

# Director's-note delivery style for premium mode.
# SPEAKY_STYLE=calm, slow, late-night radio
